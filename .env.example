# Vercel KV (Redis) - Required for caching and rate limiting
KV_REST_API_URL=your_kv_url
KV_REST_API_TOKEN=your_kv_token

# Chrome executable path (optional for local development)
CHROME_EXECUTABLE_PATH=/path/to/chrome

# Remote Python scraper service
SCRAPER_SERVICE_URL=http://127.0.0.1:8000
SCRAPER_SERVICE_TOKEN=replace-with-a-long-random-secret

# Environment
NODE_ENV=development

# Feature Flags
# Set to 'true' to enable new v2.0 features (price alerts, wishlist, export, etc.)
# Default: false (disabled)
NEXT_PUBLIC_ENABLE_V2_FEATURES=false
